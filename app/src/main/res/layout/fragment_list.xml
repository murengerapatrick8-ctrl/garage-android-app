<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Spinner
        android:id="@+id/spFiltre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:visibility="gone"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        android:visibility="gone"/>

    <ScrollView
        android:id="@+id/statsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView android:text="Mécaniciens" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvMeca" android:textSize="22sp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView android:text="Clients" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvCli" android:textSize="22sp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView android:text="Véhicules" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvVeh" android:textSize="22sp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView android:text="Interventions" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvInt" android:textSize="22sp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView android:text="Chiffre d'affaires" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvCA" android:textSize="26sp"
                android:textColor="#2E7D32"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>